{% extends "layouts/dashboard.jinja" %}

{% block title %}Dashboard - IT Career Match{% endblock %}

{% block page_title %}Dashboard{% endblock %}
{% block page_subtitle %}Tổng quan hồ sơ và gợi ý việc làm{% endblock %}

{% block content %}
{% with messages = get_flashed_messages(with_categories=true) %}
    {% if messages %}
        {% for category, message in messages %}
        <div class="alert alert-{{ 'danger' if category == 'error' else category }} alert-dismissible fade show mb-4 d-flex align-items-center justify-content-between" role="alert" style="display: flex; align-items: center; justify-content: space-between;">
            <span>{{ message }}</span>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng" style="width: 20px; height: 20px; min-width: 20px; padding: 0; margin-left: 12px; display: inline-flex; align-items: center; justify-content: center; background: transparent; border: none; cursor: pointer; opacity: 0.6; flex-shrink: 0;">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="width: 16px; height: 16px; display: block;">
                    <line x1="18" y1="6" x2="6" y2="18"></line>
                    <line x1="6" y1="6" x2="18" y2="18"></line>
                </svg>
            </button>
        </div>
        {% endfor %}
    {% endif %}
{% endwith %}

<!-- Stats Cards -->
<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        {{ stat_card('bi-file-text', cvs|length, 'CV đã tải lên', icon_color='primary') }}
    </div>
    <div class="col-6 col-md-3">
        {{ stat_card('bi-tags', skills|length, 'Kỹ năng đã khai báo', icon_color='success') }}
    </div>
    <div class="col-6 col-md-3">
        {{ stat_card('bi-lightbulb', recommendations|length, 'Gợi ý việc làm', icon_color='warning') }}
    </div>
    <div class="col-6 col-md-3">
        {% set fav_count = current_user.favourite_count if current_user.favourite_count is defined else 0 %}
        {{ stat_card('bi-heart', fav_count, 'Việc làm đã lưu', icon_color='danger') }}
    </div>
</div>

<div class="row">
    <!-- Profile Summary -->
    <div class="col-lg-4 mb-4">
        <div class="card h-100">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="card-title mb-0">Hồ sơ</h5>
                <a href="{{ url_for('profile.edit_profile') }}" class="btn btn-sm btn-outline-primary">Sửa</a>
            </div>
            <div class="card-body">
                {% if profile %}
                <dl class="row mb-0">
                    <dt class="col-sm-4 text-muted">Họ tên</dt>
                    <dd class="col-sm-8 fw-medium">{{ profile.full_name or 'Chưa cập nhật' }}</dd>

                    <dt class="col-sm-4 text-muted">Chuyên ngành</dt>
                    <dd class="col-sm-8">{{ profile.major or 'Chưa cập nhật' }}</dd>

                    <dt class="col-sm-4 text-muted">Trường ĐH</dt>
                    <dd class="col-sm-8">{{ profile.university or 'Chưa cập nhật' }}</dd>

                    <dt class="col-sm-4 text-muted">Năm TN</dt>
                    <dd class="col-sm-8">{{ profile.graduation_year or 'Chưa cập nhật' }}</dd>
                </dl>
                {% else %}
                <div class="text-center py-4">
                    <i class="bi bi-person-plus text-muted" style="font-size: 3rem;"></i>
                    <p class="text-muted mt-2">Chưa có hồ sơ</p>
                    <a href="{{ url_for('profile.edit_profile') }}" class="btn btn-primary">
                        <i class="bi bi-plus me-1"></i>Tạo hồ sơ ngay
                    </a>
                </div>
                {% endif %}
            </div>
        </div>
    </div>

    <!-- Skills -->
    <div class="col-lg-4 mb-4">
        <div class="card h-100">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="card-title mb-0">Kỹ năng</h5>
                <a href="{{ url_for('profile.edit_profile') }}" class="btn btn-sm btn-outline-primary">Sửa</a>
            </div>
            <div class="card-body">
                {% if skills %}
                <div class="d-flex flex-wrap gap-2">
                    {% for skill in skills[:15] %}
                        <span class="badge badge-primary">{{ skill.skill_name }}</span>
                    {% endfor %}
                    {% if skills|length > 15 %}
                        <span class="badge badge-secondary">+{{ skills|length - 15 }} khác</span>
                    {% endif %}
                </div>
                {% else %}
                <p class="text-muted text-center py-3 mb-0">Chưa có kỹ năng nào</p>
                {% endif %}
            </div>
        </div>
    </div>

    <!-- CVs -->
    <div class="col-lg-4 mb-4">
        <div class="card h-100">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="card-title mb-0">CV</h5>
                <a href="{{ url_for('cv.upload_cv') }}" class="btn btn-sm btn-primary">Tải lên</a>
            </div>
            <div class="card-body">
                {% if cvs %}
                <div class="list-group list-group-flush">
                    {% for cv in cvs[:5] %}
                    <div class="list-group-item px-0 d-flex justify-content-between align-items-center">
                        <div>
                            <i class="bi bi-file-earmark-pdf text-danger me-2"></i>
                            <strong>{{ cv.filename }}</strong>
                            <br><small class="text-muted">{{ cv.created_at.strftime('%d/%m/%Y') }}</small>
                        </div>
                        <span class="badge badge-success">{{ cv.extracted_skills|length if cv.extracted_skills else 0 }} skills</span>
                    </div>
                    {% endfor %}
                </div>
                {% if cvs|length > 5 %}
                <a href="{{ url_for('cv.my_cvs') }}" class="btn btn-outline-secondary w-100 mt-2">
                    Xem tất cả ({{ cvs|length }})
                </a>
                {% endif %}
                {% else %}
                <div class="text-center py-4">
                    <i class="bi bi-cloud-upload text-muted" style="font-size: 3rem;"></i>
                    <p class="text-muted mt-2">Chưa có CV</p>
                    <a href="{{ url_for('cv.upload_cv') }}" class="btn btn-primary">
                        <i class="bi bi-upload me-1"></i>Tải lên CV đầu tiên
                    </a>
                </div>
                {% endif %}
            </div>
        </div>
    </div>
</div>

<!-- Recommendations (Top 5) -->
<div class="row mb-4">
    <div class="col-12">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="card-title mb-0">Gợi ý việc làm cho bạn (Top 5)</h5>
                <a href="{{ url_for('cv.recommendations') }}" class="btn btn-sm btn-outline-primary">Xem tất cả</a>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    {% if recommendations %}
                    <table class="table table-hover mb-0 align-middle">
                        <thead class="table-light">
                            <tr>
                                <th style="width: 40%;">Vị trí & Công ty</th>
                                <th class="d-none d-md-table-cell" style="width: 15%;">Địa điểm</th>
                                <th style="width: 15%;" class="text-center">Match</th>
                                <th style="width: 15%;" class="text-center">Skills</th>
                                <th style="width: 15%;"></th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for rec in recommendations[:5] %}
                            <tr>
                                <td>
                                    <div>
                                        <strong class="text-dark">{{ rec.title }}</strong>
                                        {% if rec.career_match %}
                                            <span class="badge badge-success ms-1"><i class="bi bi-check-circle me-1"></i>Career match</span>
                                        {% endif %}
                                    </div>
                                    <div class="text-muted small mt-1">
                                        <i class="bi bi-building me-1"></i>{{ rec.company }}
                                    </div>
                                </td>
                                <td class="d-none d-md-table-cell text-muted small">
                                    <i class="bi bi-geo-alt me-1"></i>{{ rec.location }}
                                </td>
                                <td class="text-center">
                                    <div class="d-flex align-items-center justify-content-center gap-2">
                                        <span class="fw-bold fs-5 text-{% if rec.match_score >= 80 %}success{% elif rec.match_score >= 60 %}warning{% else %}danger{% endif %}">
                                            {{ "%.0f"|format(rec.match_score) }}%
                                        </span>
                                        <div class="progress flex-grow-1" style="height: 8px; max-width: 100px;">
                                            <div class="progress-bar bg-{% if rec.match_score >= 80 %}success{% elif rec.match_score >= 60 %}warning{% else %}danger{% endif %}"
                                                 style="width: {{ rec.match_score }}%"></div>
                                        </div>
                                    </div>
                                </td>
                                <td class="text-center">
                                    <span class="fw-medium text-{% if rec.skill_match >= 0.7 %}success{% elif rec.skill_match >= 0.4 %}warning{% else %}danger{% endif %}">
                                        {{ "%.0f"|format(rec.skill_match * 100) }}%
                                    </span>
                                    <br>
                                    {% set matched_count = rec.matched_skills|length if rec.matched_skills else 0 %}
                                    {% set missing_count = rec.missing_skills|length if rec.missing_skills else 0 %}
                                    {% set total_skills = matched_count + missing_count %}
                                    {% if total_skills > 0 %}
                                    <small class="text-muted">{{ matched_count }}/{{ total_skills }} skills</small>
                                    {% else %}
                                    <small class="text-muted">N/A</small>
                                    {% endif %}
                                </td>
                                <td class="text-end">
                                    <a href="{{ url_for('jobs.job_detail', job_id=rec.job_id) }}" class="btn btn-primary btn-sm">
                                        <i class="bi bi-eye me-1"></i>Chi tiết
                                    </a>
                                </td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>

                    <!-- Quick Summary Cards for Top 3 -->
                    <div class="border-top pt-3">
                        <h6 class="fw-bold mb-3">Tóm tắt nhanh Top 3</h6>
                        <div class="row g-3">
                            {% for rec in recommendations[:3] %}
                            <div class="col-12 col-md-4">
                                <div class="card card-bordered-{% if rec.match_score >= 80 %}success{% elif rec.match_score >= 60 %}warning{% else %}danger{% endif %} h-100">
                                    <div class="card-body p-3">
                                        <div class="d-flex justify-content-between align-items-start mb-2">
                                            <span class="badge badge-{% if rec.match_score >= 80 %}success{% elif rec.match_score >= 60 %}warning{% else %}danger{% endif %} fs-6 px-3 py-2">
                                                {{ "%.0f"|format(rec.match_score) }}%
                                            </span>
                                            {% if rec.career_match %}
                                            <span class="badge badge-success"><i class="bi bi-check-circle me-1"></i>Career</span>
                                            {% endif %}
                                        </div>
                                        <h6 class="fw-bold mb-1 small">{{ rec.title }}</h6>
                                        <p class="text-muted small mb-2"><i class="bi bi-building me-1"></i>{{ rec.company }}</p>

                                        {% if rec.explanation and rec.explanation.summary %}
                                        <p class="small text-muted mb-2">{{ rec.explanation.summary | safe }}</p>
                                        {% endif %}

                                        <div class="d-flex gap-1 flex-wrap">
                                            {% if rec.matched_skills %}
                                            {% for skill in rec.matched_skills[:3] %}
                                            <span class="badge badge-success px-2 py-1 small">{{ skill }}</span>
                                            {% endfor %}
                                            {% if rec.matched_skills|length > 3 %}
                                            <span class="badge badge-secondary px-2 py-1 small">+{{ rec.matched_skills|length - 3 }}</span>
                                            {% endif %}
                                            {% endif %}
                                        </div>
                                        {% if rec.missing_skills %}
                                        <div class="d-flex gap-1 flex-wrap mt-2">
                                            {% for skill in rec.missing_skills[:2] %}
                                            <span class="badge badge-danger px-2 py-1 small">{{ skill }}</span>
                                            {% endfor %}
                                            {% if rec.missing_skills|length > 2 %}
                                            <span class="badge badge-secondary px-2 py-1 small">+{{ rec.missing_skills|length - 2 }}</span>
                                            {% endif %}
                                        </div>
                                        {% endif %}
                                    </div>
                                </div>
                            </div>
                            {% endfor %}
                        </div>
                    </div>
                    {% else %}
                    <div class="text-center py-5">
                        <i class="bi bi-magic text-muted" style="font-size: 3rem;"></i>
                        <h4 class="text-muted mt-2">Chưa có gợi ý phù hợp</h4>
                        <p class="text-muted mb-4">Hệ thống cần dữ liệu để gợi ý việc làm chính xác</p>
                        <div class="d-flex gap-2 justify-content-center">
                            <a href="{{ url_for('cv.upload_cv') }}" class="btn btn-primary">
                                <i class="bi bi-upload me-1"></i>Tải lên CV
                            </a>
                            <a href="{{ url_for('profile.edit_profile') }}" class="btn btn-outline-primary">
                                <i class="bi bi-pencil me-1"></i>Cập nhật kỹ năng
                            </a>
                        </div>
                    </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Quick Actions -->
<div class="row mb-4">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <h5 class="card-title mb-0">Thao tác nhanh</h5>
            </div>
            <div class="card-body">
                {{ outline_button('Tìm việc làm', href=url_for('jobs.list_jobs'), icon='bi-search', variant='primary', class='me-2 mb-2') }}
                {{ outline_button('Tải CV mới', href=url_for('cv.upload_cv'), icon='bi-upload', variant='success', class='me-2 mb-2') }}
                {{ outline_button('Cập nhật hồ sơ', href=url_for('profile.edit_profile'), icon='bi-pencil', variant='info', class='me-2 mb-2') }}
                {{ outline_button('Xem gợi ý chi tiết', href=url_for('cv.recommendations'), icon='bi-magic', variant='warning', class='me-2 mb-2') }}
                {{ outline_button('Đơn ứng tuyển', href=url_for('jobs.my_applications'), icon='bi-folder', variant='secondary', class='me-2 mb-2') }}
                {{ outline_button('Việc đã lưu', href=url_for('jobs.my_favourites'), icon='bi-heart', variant='danger', class='me-2 mb-2') }}
            </div>
        </div>
    </div>
</div>
{% endblock %}