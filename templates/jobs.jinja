{% extends "layouts/public.jinja" %}

{% block title %}Việc làm IT - IT Career Match{% endblock %}

{% block page_title %}Việc làm IT{% endblock %}
{% block page_subtitle %}{{ pagination.total }} vị trí đang tuyển dụng{% endblock %}

{% block content %}
<div class="container py-4">
    <header class="public-page-heading mb-4">
        <h1 class="page-title mb-1">{{ self.page_title() }}</h1>
        <p class="page-subtitle mb-0">{{ self.page_subtitle() }}</p>
    </header>

<!-- Filter Bar -->
<div class="card card-bordered-primary mb-4">
    <div class="card-body">
        <form method="GET" id="filterForm" class="row g-3">
            <div class="col-12 col-md-6 col-lg-3">
                <label for="keyword" class="form-label visually-hidden">Từ khóa</label>
                <input type="text" class="form-control" id="keyword" name="keyword"
                       placeholder="Tìm kiếm vị trí, công ty..." value="{{ filters.keyword or '' }}">
            </div>
            <div class="col-12 col-md-4 col-lg-2">
                <label for="category" class="form-label visually-hidden">Danh mục</label>
                <select class="form-select" id="category" name="category">
                    <option value="">Tất cả danh mục</option>
                    {% for cat in categories %}
                        <option value="{{ cat }}" {% if filters.category == cat %}selected{% endif %}>{{ cat }}</option>
                    {% endfor %}
                </select>
            </div>
            <div class="col-12 col-md-4 col-lg-2">
                <label for="location" class="form-label visually-hidden">Địa điểm</label>
                <select class="form-select" id="location" name="location">
                    <option value="">Tất cả địa điểm</option>
                    {% for loc in locations %}
                        <option value="{{ loc }}" {% if filters.location == loc %}selected{% endif %}>{{ loc }}</option>
                    {% endfor %}
                </select>
            </div>
            <div class="col-12 col-md-4 col-lg-2">
                <label for="job_type" class="form-label visually-hidden">Loại hình</label>
                <select class="form-select" id="job_type" name="job_type">
                    <option value="">Tất cả loại hình</option>
                    {% for jt in job_types %}
                        <option value="{{ jt }}" {% if filters.job_type == jt %}selected{% endif %}>{{ jt }}</option>
                    {% endfor %}
                </select>
            </div>
            <div class="col-12 col-md-4 col-lg-2">
                <label for="level" class="form-label visually-hidden">Cấp bậc</label>
                <select class="form-select" id="level" name="level">
                    <option value="">Tất cả cấp bậc</option>
                    {% for lvl in levels %}
                        <option value="{{ lvl }}" {% if filters.level == lvl %}selected{% endif %}>{{ lvl }}</option>
                    {% endfor %}
                </select>
            </div>
            <div class="col-12 col-md-2 col-lg-1 d-flex align-items-end">
                <button type="submit" class="btn btn-outline-primary w-100" aria-label="Áp dụng bộ lọc">
                    <i class="bi bi-funnel"></i>
                </button>
            </div>
        </form>

        {% if filters %}
        <div class="mt-3">
            <small class="text-muted">Bộ lọc đang áp dụng: </small>
            {% for key, value in filters.items() %}
                {% if key != 'status' %}
                    <span class="badge badge-primary ms-1">
                        {{ key }}: {{ value }}
                        <a href="{{ url_for('jobs.list_jobs', **(filters | remove_filter(key))) }}" class="text-decoration-none text-primary ms-1">
                            <i class="bi bi-x"></i>
                        </a>
                    </span>
                {% endif %}
            {% endfor %}
            <a href="{{ url_for('jobs.list_jobs') }}" class="btn btn-link btn-sm p-0 ms-2">Xoá tất cả</a>
        </div>
        {% endif %}
    </div>
</div>

<!-- View Toggle -->
<div class="d-flex justify-content-between align-items-center mb-3">
    <div class="btn-group" role="group" aria-label="Kiểu hiển thị việc làm">
        <button type="button" class="btn btn-outline-secondary active" data-view="grid" aria-pressed="true" aria-label="Hiển thị dạng lưới" title="Dạng lưới">
            <i class="bi bi-grid"></i>
        </button>
        <button type="button" class="btn btn-outline-secondary" data-view="table" aria-pressed="false" aria-label="Hiển thị dạng bảng" title="Dạng bảng">
            <i class="bi bi-table"></i>
        </button>
    </div>
</div>

<!-- Jobs Grid View -->
<div id="jobsGrid" class="row g-4">
    {% if jobs %}
        {% for job in jobs %}
        <div class="col-12 col-md-6 col-lg-4 job-card-item">
            <div class="card card-bordered-primary card-hover h-100">
                <div class="card-body d-flex flex-column">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <span class="badge badge-{% if job.job_type == 'Remote' %}success{% elif job.job_type == 'Internship' %}info{% else %}primary{% endif %}">
                            {{ job.job_type }}
                        </span>
                        {% if job.level %}
                        <span class="badge badge-secondary">{{ job.level }}</span>
                        {% endif %}
                    </div>

                    <h5 class="card-title fw-bold mb-1">{{ job.title }}</h5>
                    <p class="card-text text-muted small mb-2">
                        <i class="bi bi-building me-1"></i>{{ job.company }}
                    </p>
                    <p class="card-text text-muted small mb-2">
                        <i class="bi bi-geo-alt me-1"></i>{{ job.location }}
                        {% if job.category %}
                            <span class="ms-2"><i class="bi bi-tag me-1"></i>{{ job.category }}</span>
                        {% endif %}
                    </p>

                    {% if job.salary_min or job.salary_max %}
                    <p class="card-text fw-semibold text-primary mb-2">
                        <i class="bi bi-currency-dollar me-1"></i>
                        {% if job.salary_min and job.salary_max %}
                            {{ "{:,.0f}".format(job.salary_min) }} - {{ "{:,.0f}".format(job.salary_max) }} VNĐ
                        {% elif job.salary_min %}
                            Từ {{ "{:,.0f}".format(job.salary_min) }} VNĐ
                        {% else %}
                            Đến {{ "{:,.0f}".format(job.salary_max) }} VNĐ
                        {% endif %}
                    </p>
                    {% endif %}

                    <div class="mt-auto pt-3 border-top">
                        <div class="d-flex gap-2">
                            <a href="{{ url_for('jobs.job_detail', job_id=job.job_id) }}" class="btn btn-outline-primary flex-grow-1">
                                Chi tiết
                            </a>
                            {% if session.get('user_id') %}
                            <button type="button" class="btn btn-outline-secondary btn-favourite"
                                    data-job-id="{{ job.job_id }}"
                                    data-favourited="{{ 'true' if is_favourite else 'false' }}"
                                    aria-label="{% if is_favourite %}Bỏ việc làm khỏi danh sách yêu thích{% else %}Lưu việc làm vào danh sách yêu thích{% endif %}"
                                    title="{% if is_favourite %}Bỏ lưu{% else %}Lưu việc làm{% endif %}">
                                <i class="bi bi-{% if is_favourite %}heart-fill text-danger{% else %}heart{% endif %}"></i>
                            </button>
                            {% endif %}
                        </div>
                    </div>
                </div>
            </div>
        </div>
        {% endfor %}
    {% else %}
        <div class="col-12 text-center py-5">
            <i class="bi bi-search text-muted" style="font-size: 4rem;"></i>
            <h4 class="text-muted mt-3">Không tìm thấy việc làm phù hợp</h4>
            <p class="text-muted">Thử xoá bộ lọc hoặc tìm kiếm từ khóa khác</p>
            <a href="{{ url_for('jobs.list_jobs') }}" class="btn btn-outline-primary">Xoá bộ lọc</a>
        </div>
    {% endif %}
</div>

<!-- Jobs Table View -->
<div id="jobsTable" class="d-none">
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>Vị trí</th>
                    <th>Công ty</th>
                    <th>Địa điểm</th>
                    <th>Loại hình</th>
                    <th>Cấp bậc</th>
                    <th>Lương</th>
                    <th class="text-end">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                {% if jobs %}
                    {% for job in jobs %}
                    <tr>
                        <td>
                            <div class="fw-medium">{{ job.title }}</div>
                            <small class="text-muted">{{ job.category or '' }}</small>
                        </td>
                        <td>{{ job.company }}</td>
                        <td>{{ job.location }}</td>
                        <td>
                            <span class="badge badge-{% if job.job_type == 'Remote' %}success{% elif job.job_type == 'Internship' %}info{% else %}primary{% endif %}">
                                {{ job.job_type }}
                            </span>
                        </td>
                        <td>{% if job.level %}<span class="badge badge-secondary">{{ job.level }}</span>{% else %}-{% endif %}</td>
                        <td>
                            {% if job.salary_min or job.salary_max %}
                                <span class="fw-medium text-primary">
                                    {% if job.salary_min and job.salary_max %}
                                        {{ "{:,.0f}".format(job.salary_min) }} - {{ "{:,.0f}".format(job.salary_max) }}
                                    {% elif job.salary_min %}
                                        Từ {{ "{:,.0f}".format(job.salary_min) }}
                                    {% else %}
                                        Đến {{ "{:,.0f}".format(job.salary_max) }}
                                    {% endif %}
                                </span> VNĐ
                            {% else %}
                                -
                            {% endif %}
                        </td>
                        <td class="text-end">
                            <div class="btn-group btn-group-sm">
                                <a href="{{ url_for('jobs.job_detail', job_id=job.job_id) }}" class="btn btn-outline-primary">Chi tiết</a>
                                {% if session.get('user_id') %}
                                <button type="button" class="btn btn-outline-secondary btn-favourite"
                                        data-job-id="{{ job.job_id }}"
                                        data-favourited="{{ 'true' if is_favourite else 'false' }}"
                                        aria-label="{% if is_favourite %}Bỏ việc làm khỏi danh sách yêu thích{% else %}Lưu việc làm vào danh sách yêu thích{% endif %}"
                                        title="{% if is_favourite %}Bỏ lưu{% else %}Lưu việc làm{% endif %}">
                                    <i class="bi bi-{% if is_favourite %}heart-fill text-danger{% else %}heart{% endif %}"></i>
                                </button>
                                {% endif %}
                            </div>
                        </td>
                    </tr>
                    {% endfor %}
                {% endif %}
            </tbody>
        </table>
    </div>
</div>

<!-- Pagination -->
{% if pagination.pages > 1 %}
<nav aria-label="Pagination" class="mt-4">
    <ul class="pagination justify-content-center">
        <li class="page-item {% if pagination.page == 1 %}disabled{% endif %}">
            <a class="page-link" href="{{ url_for('jobs.list_jobs', **(filters | remove_filter('page') | merge({'page': pagination.page - 1}))) }}">
                <i class="bi bi-chevron-left"></i>
            </a>
        </li>
        {% for p in range(max(1, pagination.page - 2), min(pagination.pages + 1, pagination.page + 3)) %}
            <li class="page-item {% if p == pagination.page %}active{% endif %}">
                <a class="page-link" href="{{ url_for('jobs.list_jobs', **(filters | remove_filter('page') | merge({'page': p}))) }}">{{ p }}</a>
            </li>
        {% endfor %}
        <li class="page-item {% if pagination.page == pagination.pages %}disabled{% endif %}">
            <a class="page-link" href="{{ url_for('jobs.list_jobs', **(filters | remove_filter('page') | merge({'page': pagination.page + 1}))) }}">
                <i class="bi bi-chevron-right"></i>
            </a>
        </li>
    </ul>
</nav>
<p class="text-center text-muted small">Trang {{ pagination.page }} / {{ pagination.pages }} ({{ pagination.total }} kết quả)</p>
{% endif %}
</div>
{% endblock %}

{% block extra_scripts %}
<script>
// View toggle
document.querySelectorAll('[data-view]').forEach(btn => {
    btn.addEventListener('click', function() {
        const view = this.dataset.view;
        document.querySelectorAll('[data-view]').forEach(b => {
            b.classList.remove('active');
            b.setAttribute('aria-pressed', 'false');
        });
        this.classList.add('active');
        this.setAttribute('aria-pressed', 'true');

        const grid = document.getElementById('jobsGrid');
        const table = document.getElementById('jobsTable');
        if (view === 'grid') {
            grid.classList.remove('d-none');
            table.classList.add('d-none');
        } else {
            grid.classList.add('d-none');
            table.classList.remove('d-none');
        }
    });
});

// Favourite button handling
document.querySelectorAll('.btn-favourite').forEach(btn => {
    btn.addEventListener('click', function() {
        const jobId = this.dataset.jobId;
        const isFav = this.dataset.favourited === 'true';

        fetch(`{{ url_for('jobs.toggle_favourite', job_id=0) }}`.replace('0', jobId), {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' }
        })
        .then(res => res.json())
        .then(data => {
            if (data.success) {
                const icon = this.querySelector('i');
                const span = this.querySelector('span');
                if (data.favourited) {
                    icon.classList.remove('bi-heart');
                    icon.classList.add('bi-heart-fill', 'text-danger');
                    this.dataset.favourited = 'true';
                    if (span) span.textContent = 'Đã lưu';
                } else {
                    icon.classList.remove('bi-heart-fill', 'text-danger');
                    icon.classList.add('bi-heart');
                    this.dataset.favourited = 'false';
                    if (span) span.textContent = 'Lưu';
                }
                const label = data.favourited
                    ? 'Bỏ việc làm khỏi danh sách yêu thích'
                    : 'Lưu việc làm vào danh sách yêu thích';
                this.setAttribute('aria-label', label);
                this.title = data.favourited ? 'Bỏ lưu' : 'Lưu việc làm';
            }
        });
    });
});

// Auto-submit filter form on change
document.querySelectorAll('#filterForm select').forEach(select => {
    select.addEventListener('change', () => document.getElementById('filterForm').submit());
});
</script>
{% endblock %}