{% extends "layouts/dashboard.jinja" %}

{% block title %}Thêm người dùng - Admin{% endblock %}

{% block page_title %}Thêm người dùng{% endblock %}
{% block page_subtitle %}Tạo tài khoản mới cho hệ thống{% endblock %}

{% block breadcrumb %}
<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb mb-0">
        <li class="breadcrumb-item"><a href="{{ url_for('admin.users') }}">Quản lý Users</a></li>
        <li class="breadcrumb-item active">Thêm mới</li>
    </ol>
</nav>
{% endblock %}

{% block content %}
<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card card-bordered-primary">
            <div class="card-body p-4">
                <h5 class="fw-bold mb-4">Thêm tài khoản</h5>

                {% if message %}
                <div class="alert alert-danger mb-4">{{ message }}</div>
                {% endif %}

                <form method="POST">
                    <div class="mb-3">
                        <label class="form-label">Họ và tên <span class="text-danger">*</span></label>
                        <input type="text" name="full_name" class="form-control" required>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Email <span class="text-danger">*</span></label>
                        <input type="email" name="email" class="form-control" required>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Mật khẩu <span class="text-danger">*</span></label>
                        <input type="password" name="password" class="form-control" minlength="6" required>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Ngành học</label>
                        <input type="text" name="major" class="form-control" placeholder="Công nghệ thông tin">
                    </div>

                    <div class="mb-4">
                        <label class="form-label">Vai trò <span class="text-danger">*</span></label>
                        <select name="role" class="form-select" required>
                            <option value="student">Student</option>
                            <option value="admin">Admin</option>
                        </select>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary flex-grow-1">
                            <i class="bi bi-plus-lg me-1"></i>Tạo tài khoản
                        </button>
                        <a href="{{ url_for('admin.users') }}" class="btn btn-outline-secondary">
                            <i class="bi bi-x-lg me-1"></i>Huỷ
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
{% endblock %}