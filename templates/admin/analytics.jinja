{% extends "layouts/dashboard.jinja" %}

{% block title %}Báo cáo & Phân tích - Admin - IT Career Match{% endblock %}

{% block page_title %}Báo cáo & Phân tích{% endblock %}
{% block page_subtitle %}Thống kê và phân tích dữ liệu hệ thống{% endblock %}

{% block content %}
<!-- Jobs by Category -->
<div class="row mb-4">
    <div class="col-lg-6 mb-4">
        <div class="card h-100">
            <div class="card-header">
                <h5 class="card-title mb-0">Việc làm theo Danh mục</h5>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    {% if by_category %}
                    <table class="table table-sm mb-0">
                        <thead><tr><th>Danh mục</th><th class="text-end">Số lượng</th></tr></thead>
                        <tbody>
                            {% for item in by_category %}
                            <tr>
                                <td>{{ item.category }}</td>
                                <td class="text-end fw-bold">{{ item.count }}</td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                    {% else %}
                    <p class="text-muted text-center py-3 mb-0">Chưa có dữ liệu</p>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-6 mb-4">
        <div class="card h-100">
            <div class="card-header">
                <h5 class="card-title mb-0">Việc làm theo Địa điểm</h5>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    {% if by_location %}
                    <table class="table table-sm mb-0">
                        <thead><tr><th>Địa điểm</th><th class="text-end">Số lượng</th></tr></thead>
                        <tbody>
                            {% for item in by_location %}
                            <tr>
                                <td>{{ item.location }}</td>
                                <td class="text-end fw-bold">{{ item.count }}</td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                    {% else %}
                    <p class="text-muted text-center py-3 mb-0">Chưa có dữ liệu</p>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row mb-4">
    <div class="col-lg-6 mb-4">
        <div class="card h-100">
            <div class="card-header">
                <h5 class="card-title mb-0">Việc làm theo Loại hình</h5>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    {% if by_type %}
                    <table class="table table-sm mb-0">
                        <thead><tr><th>Loại hình</th><th class="text-end">Số lượng</th></tr></thead>
                        <tbody>
                            {% for item in by_type %}
                            <tr>
                                <td>{{ item.job_type }}</td>
                                <td class="text-end fw-bold">{{ item.count }}</td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                    {% else %}
                    <p class="text-muted text-center py-3 mb-0">Chưa có dữ liệu</p>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-6 mb-4">
        <div class="card h-100">
            <div class="card-header">
                <h5 class="card-title mb-0">Đơn ứng tuyển theo Tháng (12 tháng gần nhất)</h5>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    {% if apps_by_month %}
                    <table class="table table-sm mb-0">
                        <thead><tr><th>Tháng</th><th class="text-end">Số đơn</th></tr></thead>
                        <tbody>
                            {% for item in apps_by_month %}
                            <tr>
                                <td>{{ item.month }}</td>
                                <td class="text-end fw-bold">{{ item.count }}</td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                    {% else %}
                    <p class="text-muted text-center py-3 mb-0">Chưa có dữ liệu</p>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Skills Demand vs Supply -->
<div class="row mb-4">
    <div class="col-lg-6 mb-4">
        <div class="card h-100">
            <div class="card-header">
                <h5 class="card-title mb-0">Kỹ năng được yêu cầu nhiều nhất (Demand)</h5>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    {% if demand_skills %}
                    <table class="table table-sm mb-0">
                        <thead><tr><th>Kỹ năng</th><th class="text-end">Số tin tuyển dụng</th></tr></thead>
                        <tbody>
                            {% for item in demand_skills %}
                            <tr>
                                <td><span class="badge badge-primary">{{ item.skill_name }}</span></td>
                                <td class="text-end fw-bold">{{ item.job_count }}</td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                    {% else %}
                    <p class="text-muted text-center py-3 mb-0">Chưa có dữ liệu</p>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-6 mb-4">
        <div class="card h-100">
            <div class="card-header">
                <h5 class="card-title mb-0">Kỹ năng ứng viên phổ biến nhất (Supply)</h5>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    {% if supply_skills %}
                    <table class="table table-sm mb-0">
                        <thead><tr><th>Kỹ năng</th><th class="text-end">Số ứng viên</th></tr></thead>
                        <tbody>
                            {% for item in supply_skills %}
                            <tr>
                                <td><span class="badge badge-success">{{ item.skill_name }}</span></td>
                                <td class="text-end fw-bold">{{ item.student_count }}</td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                    {% else %}
                    <p class="text-muted text-center py-3 mb-0">Chưa có dữ liệu</p>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Skills Gap Analysis Hint -->
<div class="card card-bordered-warning">
    <div class="card-header bg-warning bg-opacity-10">
        <h5 class="mb-0"><i class="bi bi-lightbulb me-2"></i>Phân tích khoảng trống kỹ năng (Skills Gap)</h5>
    </div>
    <div class="card-body">
        <p class="mb-2">So sánh <strong>Demand</strong> (kỹ năng doanh nghiệp cần) vs <strong>Supply</strong> (kỹ năng ứng viên có) để xác định:</p>
        <ul class="mb-0">
            <li><strong>Kỹ năng thiếu hụt (High Demand, Low Supply):</strong> Cơ hội đào tạo, upskilling</li>
            <li><strong>Kỹ năng bão hòa (High Demand, High Supply):</strong> Cạnh tranh gay gắt</li>
            <li><strong>Kỹ năng ngách (Low Demand, High Supply):</strong> Cần chuyển hướng</li>
        </ul>
    </div>
</div>
{% endblock %}