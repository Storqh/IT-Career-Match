{% extends "layouts/public.jinja" %}

{% block title %}500 - Lỗi máy chủ - IT Career Match{% endblock %}

{% block content %}
<div class="min-vh-100 d-flex align-items-center justify-content-center py-5">
    <div class="text-center px-3">
        <div class="icm-error-code mb-4 text-danger">500</div>
        <h1 class="fw-bold mb-3">Lỗi máy chủ nội bộ</h1>
        <p class="text-muted mb-4" style="max-width: 400px; margin-left: auto; margin-right: auto;">
            Đã có sự cố xảy ra. Chúng tôi đã được thông báo và đang khắc phục. Vui lòng thử lại sau.
        </p>
        <div class="d-flex gap-2 justify-content-center flex-wrap">
            <a href="{{ url_for('index') }}" class="btn btn-primary">
                <i class="bi bi-house me-1"></i>Về trang chủ
            </a>
            <button class="btn btn-outline-primary" onclick="location.reload()">
                <i class="bi bi-arrow-clockwise me-1"></i>Thử lại
            </button>
        </div>
    </div>
</div>
{% endblock %}