{% extends "layouts/public.jinja" %}

{% block title %}IT Career Match - AI Job Recommendation Platform{% endblock %}

{% block content %}
<!-- ================= HERO ================= -->
<section class="py-5 py-lg-6 bg-gradient-primary-light">
    <div class="container py-5">
        <div class="row align-items-center">
            <div class="col-lg-7">
                <span class="badge badge-primary mb-3">
                    <i class="bi bi-robot me-1" aria-hidden="true"></i>AI Career Recommendation Platform
                </span>

                <h1 class="display-4 fw-bold mb-4 text-ink">
                    Tìm công việc IT
                    <span class="text-primary">phù hợp với bạn</span>
                </h1>

                <p class="lead text-muted mb-4">
                    IT Career Match sử dụng Machine Learning để phân tích CV, nhận diện kỹ năng,
                    dự đoán định hướng nghề nghiệp và gợi ý những công việc phù hợp nhất
                    dành cho sinh viên CNTT.
                </p>

                {% if session.get("user_id") %}
                    {{ primary_button('Đi đến Dashboard', href=url_for('profile.dashboard'), icon='bi-speedometer2', class='me-2') }}
                    {{ outline_button('Xem AI Recommendation', href=url_for('cv.recommendations'), icon='bi-magic', variant='primary') }}
                {% else %}
                    {{ primary_button('Bắt đầu miễn phí', href=url_for('auth.register'), icon='bi-rocket', class='me-2') }}
                    {{ outline_button('Đăng nhập', href=url_for('auth.login'), variant='primary') }}
                {% endif %}
            </div>

            <div class="col-lg-5 mt-5 mt-lg-0">
                <div class="card card-bordered-primary shadow-lg">
                    <div class="card-body p-5">
                        <h4 class="fw-bold mb-4 text-ink">
                            <i class="bi bi-graph-up me-2 text-primary" aria-hidden="true"></i>AI Career Analysis
                        </h4>

                        <div class="mb-4">
                            <small class="text-muted">Career Prediction</small>
                            <h4 class="text-primary mt-1">AI / Machine Learning</h4>
                        </div>

                        <div class="mb-4">
                            <div class="d-flex justify-content-between mb-2">
                                <span class="fw-medium">Job Match</span>
                                <strong class="text-primary">86%</strong>
                            </div>
                            <div class="progress progress-sm">
                                <div class="progress-bar" style="width: 86%;" role="progressbar" aria-valuenow="86" aria-valuemin="0" aria-valuemax="100"></div>
                            </div>
                        </div>

                        <div>
                            <small class="text-muted">Skills detected</small>
                            <div class="mt-2 d-flex flex-wrap gap-2">
                                <span class="badge badge-success">Python</span>
                                <span class="badge badge-success">SQL</span>
                                <span class="badge badge-success">Machine Learning</span>
                                <span class="badge badge-info">TensorFlow</span>
                                <span class="badge badge-info">AWS</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ================= HOW IT WORKS ================= -->
<section class="py-5 py-lg-6">
    <div class="container py-4">
        <div class="text-center mb-5">
            <h2 class="fw-bold text-ink">Hệ thống hoạt động như thế nào?</h2>
            <p class="text-muted">Chỉ với CV của bạn, hệ thống sẽ thực hiện toàn bộ quá trình phân tích.</p>
        </div>

        <div class="row g-4">
            <div class="col-md-4">
                <div class="card card-bordered-primary card-hover h-100">
                    <div class="card-body p-4 text-center">
                        <div class="feature-icon mb-3">
                            <i class="bi bi-file-earmark-text display-4 text-primary" aria-hidden="true"></i>
                        </div>
                        <h4 class="fw-bold">1. Upload CV</h4>
                        <p class="text-muted">Upload CV PDF hoặc DOCX. Hệ thống đọc nội dung và tiền xử lý dữ liệu văn bản.</p>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card card-bordered-accent card-hover h-100">
                    <div class="card-body p-4 text-center">
                        <div class="feature-icon mb-3">
                            <i class="bi bi-cpu display-4 text-accent" aria-hidden="true"></i>
                        </div>
                        <h4 class="fw-bold">2. AI phân tích</h4>
                        <p class="text-muted">Machine Learning phân tích kỹ năng và dự đoán nhóm nghề phù hợp với hồ sơ của bạn.</p>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card card-bordered-success card-hover h-100">
                    <div class="card-body p-4 text-center">
                        <div class="feature-icon mb-3">
                            <i class="bi bi-target display-4 text-success" aria-hidden="true"></i>
                        </div>
                        <h4 class="fw-bold">3. Nhận gợi ý</h4>
                        <p class="text-muted">Hệ thống xếp hạng công việc, tính Match Score và chỉ ra những kỹ năng bạn cần bổ sung.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ================= FEATURES ================= -->
<section class="py-5 py-lg-6 bg-surface">
    <div class="container py-4">
        <div class="text-center mb-5">
            <h2 class="fw-bold text-ink">Tính năng chính</h2>
            <p class="text-muted">Công nghệ AI hỗ trợ sinh viên CNTT định hướng nghề nghiệp.</p>
        </div>

        <div class="row g-4">
            <div class="col-md-6 col-lg-3">
                <div class="card card-bordered-primary card-hover h-100">
                    <div class="card-body p-4">
                        <div class="feature-icon mb-3">
                            <i class="bi bi-search display-4 text-primary" aria-hidden="true"></i>
                        </div>
                        <h5 class="fw-bold">CV Analysis</h5>
                        <p class="text-muted mb-0">Phân tích nội dung CV và tự động trích xuất kỹ năng.</p>
                    </div>
                </div>
            </div>

            <div class="col-md-6 col-lg-3">
                <div class="card card-bordered-accent card-hover h-100">
                    <div class="card-body p-4">
                        <div class="feature-icon mb-3">
                            <i class="bi bi-lightbulb display-4 text-accent" aria-hidden="true"></i>
                        </div>
                        <h5 class="fw-bold">Career Prediction</h5>
                        <p class="text-muted mb-0">Machine Learning dự đoán nhóm nghề phù hợp với CV.</p>
                    </div>
                </div>
            </div>

            <div class="col-md-6 col-lg-3">
                <div class="card card-bordered-success card-hover h-100">
                    <div class="card-body p-4">
                        <div class="feature-icon mb-3">
                            <i class="bi bi-graph-up display-4 text-success" aria-hidden="true"></i>
                        </div>
                        <h5 class="fw-bold">Match Score</h5>
                        <p class="text-muted mb-0">Đánh giá mức độ phù hợp giữa hồ sơ và từng công việc.</p>
                    </div>
                </div>
            </div>

            <div class="col-md-6 col-lg-3">
                <div class="card card-bordered-warning card-hover h-100">
                    <div class="card-body p-4">
                        <div class="feature-icon mb-3">
                            <i class="bi bi-diagram-3 display-4 text-warning" aria-hidden="true"></i>
                        </div>
                        <h5 class="fw-bold">Skill Gap Analysis</h5>
                        <p class="text-muted mb-0">Xác định kỹ năng còn thiếu để bạn có kế hoạch học tập.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ================= TECHNOLOGY ================= -->
<section class="py-5 py-lg-6">
    <div class="container py-4 text-center">
        <h2 class="fw-bold text-ink">Công nghệ sử dụng</h2>
        <p class="text-muted mb-4">Xây dựng bằng các công nghệ phổ biến trong Web và Machine Learning.</p>

        <div class="d-flex flex-wrap justify-content-center gap-2">
            <span class="badge badge-dark p-3 badge-lg">Python</span>
            <span class="badge badge-dark p-3 badge-lg">Flask</span>
            <span class="badge badge-dark p-3 badge-lg">SQLite</span>
            <span class="badge badge-dark p-3 badge-lg">Scikit-learn</span>
            <span class="badge badge-dark p-3 badge-lg">TF-IDF</span>
            <span class="badge badge-dark p-3 badge-lg">Logistic Regression</span>
            <span class="badge badge-dark p-3 badge-lg">Bootstrap 5</span>
            <span class="badge badge-dark p-3 badge-lg">Chart.js</span>
        </div>
    </div>
</section>

<!-- ================= CTA ================= -->
<section class="py-5 py-lg-6 bg-primary text-white">
    <div class="container text-center py-4">
        <h2 class="fw-bold mb-3">Sẵn sàng tìm công việc phù hợp?</h2>
        <p class="mb-4 opacity-75">Upload CV và để AI Career Match phân tích hồ sơ của bạn.</p>

        {% if session.get("user_id") %}
            {{ primary_button('Phân tích CV ngay', href=url_for('cv.upload_cv'), icon='bi-cloud-upload', variant='light', class='btn-lg') }}
        {% else %}
            {{ primary_button('Tạo tài khoản', href=url_for('auth.register'), icon='bi-person-plus', variant='light', class='btn-lg') }}
        {% endif %}
    </div>
</section>
{% endblock %}