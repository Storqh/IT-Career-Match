# Copy this file to .env and replace the example values with your own.
# Do not commit .env or real credentials.

SECRET_KEY=replace-with-a-random-secret
FLASK_ENV=development

# PostgreSQL
DATABASE_URL=postgresql://postgres:your-password@localhost:5433/it_career_match

# Brevo email
BREVO_API_KEY=your-brevo-api-key
BREVO_SENDER_EMAIL=your-sender@example.com
BREVO_SENDER_NAME=IT Career Match
